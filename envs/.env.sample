############################################################
# .env.sample — geonode-openstack-deploy
#
# Copie para envs/.env e preencha todos os campos.
# Este arquivo controla tanto o Terraform (infra OpenStack)
# quanto a geração do .env entregue ao geonode-cluster.
############################################################


############################################################
# OPENSTACK — credenciais do TENANT
############################################################

OS_AUTH_URL=http://10.200.255.100:5000/v3
OS_PROJECT_NAME=                        # nome do projeto/tenant provisionado pelo admin
OS_USERNAME=                            # user_<tenant> gerado pelo nerdstack
OS_PASSWORD=
OS_REGION_NAME=RegionOne

# Nome da rede privada do tenant (criada pelo nerdstack)
# ex: tenant1_private_net
OS_PRIVATE_NETWORK_NAME=

# Nome da subnet privada do tenant
OS_PRIVATE_SUBNET_NAME=

# Nome da provider network (para alocar Floating IPs)
OS_PROVIDER_NETWORK=provider-network

# Imagem base das instâncias (deve existir no OpenStack)
OS_IMAGE_NAME=ubuntu-24.04


############################################################
# BRANCH DO GEONODE-CLUSTER
# Controla qual branch do repositório será clonado e implantado.
############################################################

GEONODE_BRANCH=main

# Versões dos componentes implantados
GEONODE_VERSION=5.0.2
GEOSERVER_VERSION=2.27.4
GEONODE_NGINX_IMAGE_TAG=1.28.0-v1


############################################################
# FLAVORS DAS INSTÂNCIAS
############################################################

FLAVOR_DB=m1.large
FLAVOR_GEONODE=m1.large
FLAVOR_GEOSERVER_WRITE=m1.large
FLAVOR_GEOSERVER_READ=m1.medium
FLAVOR_HAPROXY=m1.small


############################################################
# IPs FIXOS DAS INSTÂNCIAS
############################################################

IP_DB=192.168.1.100
IP_GEONODE=192.168.1.101
IP_GEOSERVER_WRITE=192.168.1.102
IP_GEOSERVER_READ_1=192.168.1.103
IP_GEOSERVER_READ_2=192.168.1.104
IP_HAPROXY_1=192.168.1.105
IP_HAPROXY_2=192.168.1.106

# IP virtual do Keepalived (VRRP)
IP_HAPROXY_VIP=192.168.1.107

# Floating IP para o VIP (acesso externo ao GeoNode)
# true  = Terraform aloca e associa um FIP ao haproxy-1
# false = acesso apenas via rede privada (WireGuard)
CREATE_FLOATING_IP_FOR_VIP=true


############################################################
# SSH
############################################################

SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
SSH_USER=ubuntu


############################################################
# BANCO DE DADOS (PostgreSQL + PostGIS)
############################################################

POSTGRES_PASSWORD=changeme_postgres
GEONODE_DB_NAME=geonode
GEONODE_DB_USER=geonode
GEONODE_DB_PASSWORD=changeme_geonode_db
GEODATA_DB_NAME=geonode_data
GEODATA_DB_USER=geonode_data
GEODATA_DB_PASSWORD=changeme_geodata_db
DB_PORT=5432


############################################################
# GEONODE — aplicação Django
############################################################

GEONODE_ADMIN_USER=admin
GEONODE_ADMIN_PASSWORD=changeme_geonode_admin
GEONODE_ADMIN_EMAIL=admin@example.com
DJANGO_SECRET_KEY=changeme_replace_with_50_random_chars

# Hostname público do GeoNode — floating IP ou FQDN.
# Usado pelo Nginx (server_name), Django (SITEURL, SITE_HOST_NAME)
# e GeoServer (URLs de callback OAuth2).
# Preenchido automaticamente pelo generate-env.sh com o FIP alocado
# pelo Terraform, mas pode ser sobrescrito aqui.
GEONODE_PUBLIC_HOSTNAME=
GEONODE_HOSTNAME=

# Porta HTTP interna do GeoNode
GEONODE_PORT=8000


############################################################
# GEOSERVER
############################################################

GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=changeme_geoserver_admin
GEOSERVER_PORT=8080

# Porta do broker JMS (ActiveMQ) usado pelo cluster GeoServer
GEOSERVER_JMS_PORT=61661


############################################################
# OAUTH2 — Integração GeoNode ↔ GeoServer
#
# Gerado automaticamente na primeira execução do invoke prepare.
# Após a primeira execução, copie os valores gerados para cá
# para que deploys futuros usem as mesmas credenciais.
#
# Para gerar manualmente:
#   ssh ubuntu@<ip_geonode> "sudo docker exec geonode_django \
#     python manage.py shell -c \
#     'from oauth2_provider.models import Application; \
#      a = Application.objects.first(); \
#      print(a.client_id); print(a.client_secret)'"
############################################################

OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=


############################################################
# HAPROXY / KEEPALIVED
############################################################

HAPROXY_STATS_PORT=8404
HAPROXY_STATS_USER=haproxy
HAPROXY_STATS_PASSWORD=changeme_haproxy_stats

# Interface de rede usada pelo Keepalived para o VRRP
KEEPALIVED_INTERFACE=ens3

# VRRP router ID (1–255, único na sub-rede)
KEEPALIVED_ROUTER_ID=51

# Porta HTTP do VIP (balanceamento)
HAPROXY_HTTP_PORT=80
HAPROXY_HTTPS_PORT=443


############################################################
# NFS (compartilhamento do datadir do GeoServer)
############################################################

NFS_EXPORT_PATH=/opt/geoserver_data
NFS_MOUNT_PATH=/opt/geoserver_data


############################################################
# HTTPS / TLS
#
# HTTPS=1         → habilita TLS no HAProxy, redireciona HTTP→HTTPS
# LETS_ENCRYPT=1  → obtém certificado via Let's Encrypt (requer DNS
#                   público apontado para o FIP e porta 80 acessível)
# LETS_ENCRYPT=0  → gera certificado autoassinado (redes internas)
# LETSENCRYPT_EMAIL → e-mail para notificações de renovação do cert
############################################################

HTTPS=0
LETS_ENCRYPT=0
LETSENCRYPT_EMAIL=
